#!/bin/sh
# A stand-in for Claude Code in tests: records its arguments and its folder, then waits to be stopped.
f="$KENDLE_STATE/claude-$$.args"
pwd > "$f"
printf '%s\n' "$@" >> "$f"
if [ -e "$KENDLE_STATE/fake-untrusted" ]; then     # as Claude Code in a folder it has not seen
    echo " Quick safety check: Is this a project you created or one you trust?"
    echo " ❯ No, exit"
    echo "   Yes, I trust this folder"
else
    echo "fake claude running"
fi
exec sleep 3600
